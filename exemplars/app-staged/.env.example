# .env.example: copy to .env.local and edit. Never commit .env.local.
# Vite bakes VITE_* values into the built files, so NOTHING secret belongs here.

# Which data stage the page uses (src/data/index.js is the only reader):
#   mockup - stage 1, hand-typed constants (the default when unset)
#   fake   - stage 2, generated rows
#   real   - stage 3, the Plumber API. The only stage `npm run ship-check` accepts.
VITE_DATA_STAGE=mockup

# Where stage 3 sends requests. Leave unset in development (vite.config.js
# forwards /api to http://localhost:8000). For the deployed page, set it to the
# deployed Plumber API, e.g. https://connect.systems-apps.com/content/<your-api-guid>
# VITE_API_URL=

# Set to false to silence the [FETCH:...] console lines.
# VITE_DEBUG_FETCH=true

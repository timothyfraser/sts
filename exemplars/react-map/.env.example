# .env.example: copy this file to .env.local and edit. Never commit .env.local.
# Vite only exposes variables that start with VITE_ to the browser, and it bakes
# them into the built files. So NOTHING secret belongs here: anyone who opens
# the deployed page can read these values.

# Where the page sends its API requests.
#   Leave it unset while developing: the page uses /api, and vite.config.js
#   forwards /api to the Plumber API on http://localhost:8000 (no CORS needed).
#   For the deployed page, set it to your deployed Plumber API's URL, e.g.
#   VITE_API_URL=https://connect.systems-apps.com/content/<your-api-guid>
# VITE_API_URL=
